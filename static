<title>Commencement 27 Portrait Countdown</title>
<style>
:root {
  --green:#046A38;
  --gold:#C99700;
  --black:#101820;
  --black-top:#1b252d;
  --black-bottom:#0c1318;
  --white:#f7f7f2;
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;background:var(--green);}
body{font-family:Arial,Helvetica,sans-serif;color:white;overflow:hidden;}

.screen {
  width:100vw;
  height:100vh;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  gap:0;
  padding:3vh 4vw 3vh;
  background:var(--green);
}

.nova {
  text-align:center;
  font-weight:800;
  letter-spacing:.14em;
  font-size:clamp(18px,2.2vw,42px);
  line-height:1.15;
}
.nova span {
  display:block;
  margin-top:.55em;
  font-size:.48em;
  letter-spacing:.24em;
  font-weight:700;
}

.logo-wrap {
  width:100%;
  display:flex;
  justify-content:center;
  align-items:center;
  margin-top:1vh;
}
.logo-wrap img {
  display:block;
  width:min(90vw,950px);
  height:auto;
}

.countdown {
  width:100%;
  display:grid;
  grid-template-columns:1.18fr .92fr .92fr .92fr;
  gap:1.2vw;
  align-items:center;
  justify-items:center;
}

.unit {text-align:center;width:100%;}
.digits {
  display:flex;
  justify-content:center;
  gap:.55vw;
}

.flip-card {
  position:relative;
  width:clamp(48px,7.25vw,88px);
  height:clamp(66px,9.4vw,114px);
  perspective:1400px;
  filter:drop-shadow(0 8px 10px rgba(0,0,0,.30));
}
.card-half,.flip-half {
  position:absolute;left:0;width:100%;height:50%;overflow:hidden;
  backface-visibility:hidden;color:var(--white);background:var(--black);
}
.card-half.top,.flip-half.top {
  top:0;border-radius:12px 12px 2px 2px;
  background:linear-gradient(180deg,var(--black-top),var(--black));
  border-bottom:1px solid #05090c;
}
.card-half.bottom,.flip-half.bottom {
  bottom:0;border-radius:2px 2px 12px 12px;
  background:linear-gradient(180deg,var(--black),var(--black-bottom));
  border-top:1px solid rgba(255,255,255,.03);
}
.card-half span,.flip-half span {
  position:absolute;left:0;width:100%;height:200%;
  display:flex;align-items:center;justify-content:center;
  font-family:"Arial Narrow",Arial,Helvetica,sans-serif;
  font-size:clamp(43px,7.05vw,84px);font-weight:800;line-height:1;
  letter-spacing:-.04em;font-variant-numeric:tabular-nums;text-shadow:0 2px 0 #000;
}
.top span{top:0} .bottom span{bottom:0}
.flip-half.top{z-index:6;transform-origin:bottom}
.flip-half.bottom{z-index:5;transform-origin:top;transform:rotateX(90deg)}
.flip-card.flipping .flip-half.top{animation:flipTop .28s cubic-bezier(.55,.05,.85,.35) forwards}
.flip-card.flipping .flip-half.bottom{animation:flipBottom .28s .28s cubic-bezier(.15,.45,.25,1) forwards}
@keyframes flipTop{0%{transform:rotateX(0);filter:brightness(1)}100%{transform:rotateX(-90deg);filter:brightness(.62)}}
@keyframes flipBottom{0%{transform:rotateX(90deg);filter:brightness(.62)}100%{transform:rotateX(0);filter:brightness(1)}}
.seam {
  position:absolute;left:0;right:0;top:50%;height:2px;transform:translateY(-1px);
  background:#06090b;box-shadow:0 1px 0 rgba(255,255,255,.05);z-index:10;
}
.label {
  margin-top:1.2vh;font-size:clamp(11px,1.75vw,24px);
  font-weight:800;letter-spacing:.18em;
  color:var(--gold);
}

.date-row {
  width:100%;display:flex;align-items:center;gap:2.5vw;
}
.rule{flex:1;height:5px;background:var(--gold)}
.date {
  white-space:nowrap;text-align:center;font-size:clamp(26px,4vw,54px);
  line-height:1;font-weight:800;letter-spacing:.015em;
}
.tagline {
  margin-top:auto;
  margin-bottom:1vh;
  font-size:clamp(18px,2.2vw,32px);
  letter-spacing:.12em;text-transform:uppercase;font-weight:700;text-align:center;
}
.year-mark {
  font-size:clamp(100px,22vw,270px);
  font-weight:900;
  line-height:.82;
  letter-spacing:-.06em;
  color:rgba(255,255,255,.07);
  margin-top:2vh;
